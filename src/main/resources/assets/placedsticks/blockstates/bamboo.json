{
  "multipart": [
    {
      "when": { "axis_y": "true" },
      "apply": { "model": "placedsticks:block/bamboo_y" }
    },
    {
      "when": { "axis_x": "true" },
      "apply": { "model": "placedsticks:block/bamboo_x", "x": 90, "y": 90 }
    },
    {
      "when": { "axis_z": "true" },
      "apply": { "model": "placedsticks:block/bamboo_z", "x": 90 }
    }
  ]
}
